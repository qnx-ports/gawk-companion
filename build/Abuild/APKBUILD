pkgname=gawk
pkgver=5.3.2
pkgrel=0
pkgdesc="GNU awk pattern-matching language"
url="https://www.gnu.org/software/gawk/gawk.html"
arch="all"
license="GPL-3.0-or-later"
depends="mpfr qnx-io-sock"
makedepends="mpfr-dev gmp-dev qnx-io-sock-dev automake libtool m4 gettext-dev"
subpackages="$pkgname-doc"
source="https://mirror.csclub.uwaterloo.ca/gnu/gawk/gawk-$pkgver.tar.xz
    fix-qnx.patch"

prepare() {
    default_prepare

    # TODO: https://lists.gnu.org/archive/html/bug-gawk/2021-02/msg00005.html
    sed -i test/Makefile.in -e "/clos1way6/d"
    autoreconf -fiv
}

build() {
    LDFLAGS="$LDFLAGS -lregex" \
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --mandir=/usr/share/man \
        --infodir=/usr/share/info \
        --disable-nls \
        --disable-pma
    make
}

package() {
    make DESTDIR="$pkgdir" install
}


